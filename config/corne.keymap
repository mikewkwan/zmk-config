#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#define KEYS_L 0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29    // Left hand alpha matrix
#define KEYS_R 6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 // Right hand alpha matrix
#define THUMBS 36 37 38 39 40 41                                 // All thumb keys

/ {
    behaviors {
        // --- Standard Timeless Mods (Ctrl, Alt, Gui) ---
        hml: homerow_mods_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>; 
            bindings = <&kp &kp>; // Fixed: Removed comma and split brackets
            hold-trigger-key-positions = <KEYS_R THUMBS>; 
            hold-trigger-on-release;
        };
        hmr: homerow_mods_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp &kp>; // Fixed: Removed comma and split brackets
            hold-trigger-key-positions = <KEYS_L THUMBS>;
            hold-trigger-on-release;
        };

        // --- Specialized Fast Shift Mods ---
        hmsl: homerow_shift_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <175>;             
            quick-tap-ms = <175>;
            require-prior-idle-ms = <0>;          
            bindings = <&kp &kp>; // Fixed: Removed comma and split brackets
            hold-trigger-key-positions = <KEYS_R THUMBS>;
            hold-trigger-on-release;
        };
        hmsr: homerow_shift_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <175>;             
            quick-tap-ms = <175>;
            require-prior-idle-ms = <0>;          
            bindings = <&kp &kp>; // Fixed: Removed comma and split brackets
            hold-trigger-key-positions = <KEYS_L THUMBS>;
            hold-trigger-on-release;
        };
        hyper_tap: hyper_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "HYPER_TAP";
            #binding-cells = <2>; 
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
            bindings = <&kp &kp>;
        };
        // 1. Define the Sticky Hyper behavior (Now accepts a keycode argument)
        sk_hyper: sticky_hyper {
            compatible = "zmk,behavior-sticky-key";
            #binding-cells = <1>;                        // Changed to 1 to accept an argument
            bindings = <&kp>;                            // Removed the hardcoded modifiers
            release-after-ms = <1500>; 
            quick-release;
        };

        // 2. Define the Hold-Tap behavior 
        hyper_ht: hyper_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>; 
            flavor = "tap-preferred";
            tapping-term-ms = <200>; 
            bindings = <&kp>, <&sk_hyper>;               // Both &kp and &sk_hyper now expect 1 argument
        };

        excl_ques_td: tap_dance_0 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mt EXCLAMATION LCTRL>, <&kp LS(SLASH)>;
        };
    }; // Fixed: Added missing closing brace for behaviors block

    combos {
        compatible = "zmk,combos";
        combo_mo4 {
            timeout-ms = <50>;
            key-positions = <37 40>;
            bindings = <&mo 4>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
// -----------------------------------------------------------------------------------------
// |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BSPC |
// | l1/ESC |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
// | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
//                    | Hy` | l2SPC | ShTab |   | ENT | l3SPC  | modstickyhyper |
            bindings = <
   &kp TAB   &kp Q &kp W &kp E &kp R &kp T   &kp Y &kp U  &kp I     &kp O   &kp P    &kp BSPC
   &lt 1 ESC &hml LCTRL A &hmsl LSHIFT S &hml LALT D &hml LGUI F &kp G   &kp H &hmr RGUI J  &hmr RALT K     &hmsr RSHIFT L   &hmr RCTRL SEMI &kp SQT
   &kp LSHFT &kp Z &kp X &kp C &kp V &kp B   &kp N &kp M  &kp COMMA &kp DOT &kp FSLH &kp ESC
                  &hyper_tap LC(LS(LA(LGUI))) GRAVE &lt 2 SPACE  &mt LSHIFT TAB   &kp RET &lt 3 SPACE &hyper_ht LC(LA(LS(LGUI))) LC(LA(LS(LGUI)))
            >;
        };
        nav_layer {
// -----------------------------------------------------------------------------------------
// |      |     |BKsp | DEL |     |     |   |     | PRV | PLAY| NXT |     | DEL  |
// |      |     |     |     |     |     |   | LFT | DWN |  UP | RGT |     |      |
// |      |     |LG(X)|LG(C)|LG(V)|     |   |     |     |     |     |     |      |
//                    |     |hyEND|     |   |     |     |     |
            bindings = <
&trans  &trans  &kp BACKSPACE &kp DEL  &trans  &trans  &trans &kp C_PREVIOUS &kp C_PLAY_PAUSE &kp C_NEXT &trans &kp DEL
&trans  &trans  &trans &trans   &trans  &trans  &kp LEFT  &kp DOWN &kp UP  &kp RIGHT  &kp F19   &trans
&trans  &trans  &kp LG(X) &kp LG(C)  &kp LG(V) &trans  &trans &trans  &trans  &trans &trans &trans
                        &trans  &kp LC(LA(LS(LG(END))))  &trans  &trans &trans  &trans
            >;
        };

        num_layer {
// -----------------------------------------------------------------------------------------
// |      |  ^  |  <  |  >  |  @  |  #  |   |     |  7  |  8  |  9  |     |      |
// | hyEND| !C? | S-  |  A+ |  G= |  $  |   |  \  |  4  |  5  |  6  |     |   "  |
// |      |  ?  |  _  |  *  |  &  |  %  |   |  |  |  1  |  2  |  3  |     |      |
//                    |     |     |     |   |  ,  |  0  |  .  |
            bindings = <
&trans  &kp LS(N6)  &kp LS(COMMA)  &kp LS(PERIOD)   &kp LS(N2)  &kp LS(N3)  &trans &kp N7 &kp N8 &kp N9 &trans &trans
&kp LC(LA(LS(LG(END))))  &excl_ques_td  &mt LEFT_SHIFT MINUS  &mt LALT LS(EQUAL) &mt LGUI EQUAL &kp LS(N4)  &kp BACKSLASH &kp N4 &kp N5 &kp N6 &trans &kp LS(SINGLE_QUOTE)
&trans  &kp LS(SLASH)  &kp LS(MINUS)  &kp LS(N8)   &kp LS(N7)  &kp LS(N5)  &kp LS(BACKSLASH) &kp N1 &kp N2 &kp N3 &trans &trans
                        &trans   &trans  &trans  &kp COMMA &kp N0  &kp PERIOD
            >;
        };

        symbol_layer {
// -----------------------------------------------------------------------------------------
// |      |  ^  |  <  |  >  |  @  |  #  |   |     |  "  |  {  |  }  |     |      |
// | hyEND| !C? | S-  |  A+ |  G= |  $  |   |  \  |  '  |  (  |  )  |     |   "  |
// |      |  ?  |  _  |  *  |  &  |  %  |   |  |  |  _  |  [  |  ]  |     |      |
//                    |     |     |     |   |     |     |     |
            bindings = <
&trans  &kp LS(N6)  &kp LS(COMMA)  &kp LS(PERIOD)   &kp LS(N2)  &kp LS(N3)  &trans &kp LS(SINGLE_QUOTE) &kp LS(LEFT_BRACKET) &kp LS(RIGHT_BRACKET) &trans &trans
&kp LC(LA(LS(LG(END))))  &excl_ques_td  &mt LSHIFT MINUS  &mt LALT LS(EQUAL) &mt LGUI EQUAL &kp LS(N4) &kp BACKSLASH &mt RGUI SINGLE_QUOTE &mt RALT LEFT_PARENTHESIS &mt RSHIFT RIGHT_PARENTHESIS &trans &kp LS(SINGLE_QUOTE)
&trans  &kp LS(SLASH)  &kp LS(MINUS)  &kp LS(N8)   &kp LS(N7)  &kp LS(N5)  &kp LS(BACKSLASH) &kp LS(MINUS) &kp LEFT_BRACE &kp RIGHT_BRACE &trans &trans
                        &trans   &trans  &trans  &trans &trans  &trans
            >;
        };

        lower_layer {
// -----------------------------------------------------------------------------------------
// |unlock|  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BSPC |
// | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
// | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
//                    | GUI |     | SPC |   | ENT |     | ALT |
            bindings = <
   &studio_unlock    &kp N1       &kp N2       &kp N3       &kp N4       &kp N5         &kp N6   &kp N7   &kp N8 &kp N9    &kp N0 &kp BSPC
   &bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4   &trans &trans &trans &trans &trans &trans
   &kp LSHFT  &trans       &trans       &trans       &trans       &trans         &trans   &trans   &trans &trans    &trans &trans
                                    &trans     &trans       &trans      &trans  &trans   &trans
            >;
        };
    };
};
