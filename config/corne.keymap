#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

&sk {
    release-after-ms = <2000>;
    quick-release;
};

/ {
    behaviors {
        // --- Homerow Mods ---
        hml: homerow_mods_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            bindings = <&kp>, <&kp>;
        };
        hmr: homerow_mods_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            bindings = <&kp>, <&kp>;
        };
        hyper_tap: hyper_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "HYPER_TAP";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    }; // Fixed: Added missing closing brace for behaviors block

    combos {
        compatible = "zmk,combos";
        combo_mo4 {
            timeout-ms = <50>;
            key-positions = <37 40>;
            bindings = <&mo 4>;
        };

        combo_f19 {
            timeout-ms = <50>;
            key-positions = <16 19>;
            bindings = <&kp F19>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
// -----------------------------------------------------------------------------------------
// |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BSPC |
// |NAVESC|  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
// | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  |  -   |
//                    | Hy` |NUMSP|ShTab|   | ENT |SYSPC | stickyhyper |
            bindings = <
   &kp TAB   &kp Q &kp W &kp E &kp R &kp T   &kp Y &kp U  &kp I     &kp O   &kp P    &kp BSPC
   &lt 1 ESC &hml LCTRL A &hml LSHIFT S &hml LALT D &hml LGUI F &kp G   &kp H &hmr RGUI J  &hmr RALT K     &hmr RSHIFT L   &hmr RCTRL SEMICOLON &kp SQT
   &kp LSHFT &kp Z &kp X &kp C &kp V &kp B   &kp N &kp M  &kp COMMA &kp DOT &kp FSLH &kp MINUS
                  &hyper_tap LC(LS(LA(LGUI))) GRAVE &lt 2 SPACE  &mt LSHIFT TAB   &kp RET &lt 3 SPACE &sk LC(LA(LS(LGUI)))
            >;
        };
        nav_layer {
// -----------------------------------------------------------------------------------------
// |      |     |BKsp | DEL |     |     |   |     | PRV | PLAY| NXT |     | DEL  |
// |      |     |     |     |     |     |   | LFT | DWN |  UP | RGT | F19 |      |
// |      |     |LG(X)|LG(C)|LG(V)|     |   |     |     |     |     |     |      |
//                    |     |hyEND|     |   |     |     |     |
            bindings = <
&trans  &trans  &kp BACKSPACE &kp DEL  &trans  &trans  &trans &kp C_PREVIOUS &kp C_PLAY_PAUSE &kp C_NEXT &trans &kp DEL
&trans  &trans  &trans &trans   &trans  &trans  &kp LEFT  &kp DOWN &kp UP  &kp RIGHT  &kp F19   &trans
&trans  &trans  &kp LG(X) &kp LG(C)  &kp LG(V) &trans  &trans &trans  &trans  &trans &trans &trans
                        &trans  &kp LC(LA(LS(LG(END))))  &trans  &trans &trans  &trans
            >;
        };

        num_layer {
// -----------------------------------------------------------------------------------------
// |      |  ^  |  <  |  >  |  @  |  #  |   |     |  7  |  8  |  9  |     |      |
// | hyEND|  C! | S-  |  A+ |  G= |  $  |   |  \  |  4  |  5  |  6  |     |   "  |
// |      |  ?  |  _  |  *  |  &  |  %  |   |  |  |  1  |  2  |  3  |     |      |
//                    |     |     |     |   |  ,  |  0  |  .  |
            bindings = <
&trans  &kp LS(N6)  &kp LS(COMMA)  &kp LS(PERIOD)   &kp LS(N2)  &kp LS(N3)  &trans &kp N7 &kp N8 &kp N9 &trans &trans
&kp LC(LA(LS(LG(END))))  &hml LCTRL EXCLAMATION  &hml LEFT_SHIFT MINUS  &hml LALT LS(EQUAL) &hml LGUI EQUAL &kp LS(N4)  &kp BACKSLASH &hmr RGUI N4 &hmr RALT N5 &hmr RSHIFT N6 &hmr RCTRL LS(SEMICOLON) &kp LS(SINGLE_QUOTE)
&trans  &kp LS(SLASH)  &kp LS(MINUS)  &kp LS(N8)   &kp LS(N7)  &kp LS(N5)  &kp LS(BACKSLASH) &kp N1 &kp N2 &kp N3 &trans &trans
                        &trans   &trans  &trans  &kp COMMA &kp N0  &kp PERIOD
            >;
        };

        symbol_layer {
// -----------------------------------------------------------------------------------------
// |      |  ^  |  <  |  >  |  @  |  #  |   |     |  "  |  {  |  }  |     |      |
// | hyEND|  C! | S-  |  A+ |  G= |  $  |   |  \  |  '  |  (  |  )  |     |   "  |
// |      |  ?  |  _  |  *  |  &  |  %  |   |  |  |  _  |  [  |  ]  |     |      |
//                    |     |     |     |   |     |     |     |
            bindings = <
&trans  &kp LS(N6)  &kp LS(COMMA)  &kp LS(PERIOD)   &kp LS(N2)  &kp LS(N3)  &trans &kp LS(SINGLE_QUOTE) &kp LS(LEFT_BRACKET) &kp LS(RIGHT_BRACKET) &trans &trans
&kp LC(LA(LS(LG(END))))  &hml LCTRL EXCLAMATION  &hml LSHIFT MINUS  &hml LALT LS(EQUAL) &hml LGUI EQUAL &kp LS(N4) &kp BACKSLASH &hmr RGUI SINGLE_QUOTE &hmr RALT LEFT_PARENTHESIS &hmr RSHIFT RIGHT_PARENTHESIS &hmr RCTRL LS(SEMICOLON) &kp LS(SINGLE_QUOTE)
&trans  &kp LS(SLASH)  &kp LS(MINUS)  &kp LS(N8)   &kp LS(N7)  &kp LS(N5)  &kp LS(BACKSLASH) &kp LS(MINUS) &kp LEFT_BRACE &kp RIGHT_BRACE &trans &trans
                        &trans   &trans  &trans  &trans &trans  &trans
            >;
        };

        lower_layer {
// -----------------------------------------------------------------------------------------
// |unlock|  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BSPC |
// | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   |     |     |     |     |     |      |
// | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
//                    |     |     |     |   |     |     |     |
            bindings = <
   &studio_unlock    &kp N1       &kp N2       &kp N3       &kp N4       &kp N5         &kp N6   &kp N7   &kp N8 &kp N9    &kp N0 &kp BSPC
   &bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4   &trans &trans &trans &trans &trans &trans
   &kp LSHFT  &trans       &trans       &trans       &trans       &trans         &trans   &trans   &trans &trans    &trans &trans
                                    &trans     &trans       &trans      &trans  &trans   &trans
            >;
        };
    };
};
